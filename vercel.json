{
  "version": 2,
  "outputDirectory": "public",
  "buildCommand": "echo 'Assets pre-built'",
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.9.2"
    }
  ],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.2"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(css|js|images|fonts|storage)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite"
  }
}
